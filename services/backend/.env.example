# Local development: docker Postgres over TCP (`pnpm db:up`).
# DATABASE_DRIVER selects the postgres-js driver in the factory; it works inside
# `wrangler dev` because of the nodejs_compat flag in wrangler.toml.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/restaurant
DATABASE_DRIVER=postgres

# Production sets only DATABASE_URL, pointing at Neon, and omits
# DATABASE_DRIVER so the factory falls through to the Neon WebSocket driver.
