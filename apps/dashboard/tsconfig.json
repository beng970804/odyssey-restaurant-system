{
  "extends": "@repo/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "types": ["react"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.tsx",
    "vitest.config.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
